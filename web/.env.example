# Copy to web/.env.local (gitignored). Every variable here is public: Next.js inlines
# NEXT_PUBLIC_* into the browser bundle at build time, so a change needs a rebuild, and
# nothing secret ever belongs in this file. The API's secrets live in api/.env.

# Platform API. Unset = the built-in mocks (checkout, dashboard, account) with seeded data.
NEXT_PUBLIC_ELAPSE_API_URL=http://localhost:4000

# Privy app id (App settings → Basics). Same app the API verifies identity tokens for.
NEXT_PUBLIC_PRIVY_APP_ID=

# Chain the checkout wallet targets: 10143 Monad testnet, 143 mainnet.
NEXT_PUBLIC_CHAIN_ID=10143
# Optional RPC overrides; defaults are the public Monad endpoints.
# NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# NEXT_PUBLIC_MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# Force the dashboard mock even when the API URL is set (local UI work only).
# NEXT_PUBLIC_DASHBOARD_MOCK=1
